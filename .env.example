# Copy to .env for SERVER use only; do not ship .env inside an installer.
# Requires Node.js 24.22.1+ with node:sqlite and native crypto.argon2.
NODE_ENV=development
ZEN_HOST=127.0.0.1
PORT=4173
# Empty in local mode. For a hosted server use your actual HTTPS origin:
ZEN_PUBLIC_URL=
# Prefer an absolute directory outside the source checkout on your server.
ZEN_DATA_DIR=.zentro-data
# Optional: behind a reverse proxy running on the same host only.
ZEN_TRUST_PROXY=0
# Optional encrypted scheduled backups. Empty passphrase disables scheduling.
# Choose a unique 14-128 character passphrase in a protected environment/secret store.
ZEN_BACKUP_PASSPHRASE=
ZEN_BACKUP_DIR=.zentro-backups
ZEN_BACKUP_INTERVAL_HOURS=24
